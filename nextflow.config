params {
  datasets = "${projectDir}/config/datasets.tsv"
  analyses = "${projectDir}/config/analysis.tsv"
  outdir = "${launchDir}/vidar_results"
  mode = 'apply'
  split = false
  split_by = 'cell_type'
  condition = 'sample'
  cluster = 'phase'
  ommverse = null
  string_info = null
  string_links = null
  models_dir = "${launchDir}/models"
  traconmech = 'traconmech'
  sc_analyse = 'sc-analyse'
  lumrik_image = 'ghcr.io/stela2502/lumrik:v0.9.2'
  max_parallel = 1
}
process {
  executor = 'local'
  shell = ['/bin/bash','-ue']
  errorStrategy = 'terminate'
  maxForks = params.max_parallel
  container = params.lumrik_image
}
profiles {
  local { process.container = null }
  apptainer { apptainer.enabled = true; apptainer.autoMounts = true }
  slurm { process.executor = 'slurm'; apptainer.enabled = true; apptainer.autoMounts = true }
}
